# ---------------------------------------------------------------------------
# Docker/VPS deployment env - copy this file to `.env` next to
# docker-compose.yml on the server (NOT committed to git; `.env` is already
# in .gitignore) and fill in every placeholder below before running
# `docker compose up -d`. See DEPLOYMENT.md for the full walkthrough.
# ---------------------------------------------------------------------------

APP_NAME="CY-Market"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Your real domain, including https:// - MOMO_CALLBACK_URL below derives from this automatically.
APP_URL=https://yourdomain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# DB_HOST is the docker-compose service name ("db"), not an IP - Docker's
# internal DNS resolves it. DB_ROOT_PASSWORD is only used to initialise the
# MySQL container and for its healthcheck.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=cymarket
DB_USERNAME=cymarket
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# The host port docker-compose.yml maps the app container's port 80 to
# (see the "app" service's `ports:` entry). Change this if 80 is already
# taken by something else on the VPS, or leave it if a reverse proxy /
# Hostinger's own SSL layer will forward traffic to it.
APP_PORT=80

# ---------------------------------------------------------------------------
# CY-Market platform settings
# ---------------------------------------------------------------------------
CYMARKET_DEFAULT_DELIVERY_FEE=15.00
CYMARKET_PILOT_ZONE_NAME="Tarkwa & Surrounding Communities"
CYMARKET_STOCK_RESERVATION_MINUTES=15
CYMARKET_ABANDONED_CART_HOURS=48
CYMARKET_ORDER_ESCALATION_HOURS=6
CYMARKET_CURRENCY=GHS

# ---------------------------------------------------------------------------
# MTN Mobile Money (Collection API "Request to Pay") - the pilot payment
# method. MOMO_MODE=simulate runs the full checkout against a local mock
# page with zero credentials. For MTN's developer sandbox use
# MOMO_MODE=live + MOMO_ENVIRONMENT=sandbox + MOMO_CURRENCY=EUR. For real
# payments in Ghana use MOMO_MODE=live, MOMO_ENVIRONMENT=mtnghana,
# MOMO_BASE_URL=https://proxy.momoapi.mtn.com, MOMO_CURRENCY=GHS and the
# credentials MTN Ghana issues you.
MOMO_MODE=simulate
MOMO_ENVIRONMENT=sandbox
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
MOMO_CURRENCY=GHS
MOMO_CALLBACK_URL="${APP_URL}/webhooks/mtn-momo"

# ---------------------------------------------------------------------------
# Google Maps (delivery-location picker at checkout + admin order location
# map). Create a billing-enabled key with the Maps JavaScript API allowed at
# https://console.cloud.google.com/google/maps-apis - both features show a
# "not configured" notice instead of loading Google's script while this is
# blank.
# ---------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------------------
# SMS gateway (transactional order-lifecycle notifications)
# log mode writes messages to storage/logs instead of sending them - switch
# to your real gateway when you're ready to send live SMS.
# ---------------------------------------------------------------------------
SMS_MODE=log
SMS_GATEWAY_BASE_URL=
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_CLIENT_ID=
SMS_GATEWAY_SENDER_ID=CYMarket
SMS_RETRY_ATTEMPTS=3

# ---------------------------------------------------------------------------
# Filament admin panel
# ---------------------------------------------------------------------------
FILAMENT_DOMAIN=
FILAMENT_PATH=admin
