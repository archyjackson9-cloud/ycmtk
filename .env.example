APP_NAME="CY-Market"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# CY-Market platform settings
# ---------------------------------------------------------------------------
# Fixed delivery fee (GHS) and pilot behaviour can also be changed live from
# Admin > Settings once the app is seeded; these are just the first defaults.
CYMARKET_DEFAULT_DELIVERY_FEE=15.00
CYMARKET_PILOT_ZONE_NAME="Tarkwa & Surrounding Communities"
CYMARKET_STOCK_RESERVATION_MINUTES=15
CYMARKET_ABANDONED_CART_HOURS=48
CYMARKET_ORDER_ESCALATION_HOURS=6
CYMARKET_CURRENCY=GHS

# ---------------------------------------------------------------------------
# Hubtel Mobile Money (Receive Money / Checkout API)
# Sandbox/mock mode is ON by default so the full checkout flow can be tested
# without live credentials. Set HUBTEL_MODE=live and fill in the credentials
# below when Hubtel supplies them (see Section 6.5 / 10 of the TOR).
# ---------------------------------------------------------------------------
HUBTEL_MODE=sandbox
HUBTEL_BASE_URL=https://payproxyapi.hubtel.com
HUBTEL_POS_SALES_ID=
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_MERCHANT_ACCOUNT_NUMBER=
HUBTEL_CALLBACK_URL="${APP_URL}/webhooks/hubtel"
HUBTEL_RETURN_URL="${APP_URL}/checkout/return"

# ---------------------------------------------------------------------------
# SMS gateway (transactional order-lifecycle notifications)
# log mode writes messages to storage/logs instead of sending them, so the
# whole order flow is testable with zero credentials.
# ---------------------------------------------------------------------------
SMS_MODE=log
SMS_GATEWAY_BASE_URL=
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_CLIENT_ID=
SMS_GATEWAY_SENDER_ID=CYMarket
SMS_RETRY_ATTEMPTS=3

# ---------------------------------------------------------------------------
# Filament admin panel
# ---------------------------------------------------------------------------
FILAMENT_DOMAIN=
FILAMENT_PATH=admin
