APP_NAME="CY-Market"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# CY-Market platform settings
# ---------------------------------------------------------------------------
# Fixed delivery fee (GHS) and pilot behaviour can also be changed live from
# Admin > Settings once the app is seeded; these are just the first defaults.
CYMARKET_DEFAULT_DELIVERY_FEE=15.00
CYMARKET_PILOT_ZONE_NAME="Tarkwa & Surrounding Communities"
CYMARKET_STOCK_RESERVATION_MINUTES=15
CYMARKET_ABANDONED_CART_HOURS=48
CYMARKET_ORDER_ESCALATION_HOURS=6
CYMARKET_CURRENCY=GHS

# ---------------------------------------------------------------------------
# MTN Mobile Money (Collection API "Request to Pay") - the pilot payment
# method. MOMO_MODE=simulate runs the full checkout against a local mock
# page with zero credentials. For MTN's developer sandbox use
# MOMO_MODE=live + MOMO_ENVIRONMENT=sandbox + MOMO_CURRENCY=EUR. For real
# payments in Ghana use MOMO_MODE=live, MOMO_ENVIRONMENT=mtnghana,
# MOMO_BASE_URL=https://proxy.momoapi.mtn.com, MOMO_CURRENCY=GHS and the
# credentials MTN Ghana issues you.
MOMO_MODE=simulate
MOMO_ENVIRONMENT=sandbox
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
MOMO_CURRENCY=EUR
MOMO_CALLBACK_URL="${APP_URL}/webhooks/mtn-momo"

# ---------------------------------------------------------------------------
# Google Maps (delivery-location picker at checkout + admin order location
# map). Create a billing-enabled key with the Maps JavaScript API allowed at
# https://console.cloud.google.com/google/maps-apis - both features show a
# "not configured" notice instead of loading Google's script while this is
# blank.
# ---------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------------------
# SMS gateway (transactional order-lifecycle notifications)
# log mode writes messages to storage/logs instead of sending them, so the
# whole order flow is testable with zero credentials.
# ---------------------------------------------------------------------------
SMS_MODE=log
SMS_GATEWAY_BASE_URL=
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_CLIENT_ID=
SMS_GATEWAY_SENDER_ID=CYMarket
SMS_RETRY_ATTEMPTS=3

# ---------------------------------------------------------------------------
# Filament admin panel
# ---------------------------------------------------------------------------
FILAMENT_DOMAIN=
FILAMENT_PATH=admin
